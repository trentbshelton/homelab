#!/usr/bin/env bash
# Send a push notification to Trent's phone through Pushover.
#
#   notify [-p low|normal|high|urgent] [-u URL] "Title" "Message"
#
# Every alert on every machine goes through this one command, so switching
# providers later means changing this file and nothing else.
#
# Keys live in /etc/notify.env (root-only):
#   PUSHOVER_TOKEN=...   the "Homelab" application's API token
#   PUSHOVER_USER=...    Trent's user key
#
# Priorities:
#   low     no sound or vibration, just shows up in the list
#   normal  the default
#   high    makes a sound even during quiet hours
#   urgent  repeats every minute for up to an hour until acknowledged
#
# Pushover is a hosted service, so alerts still go out when the homelab
# itself is in trouble. If the network isn't up yet (early boot), it retries
# for up to 2 minutes before giving up and logging the message instead.
set -uo pipefail

prio=0
url=""
while getopts "p:u:" opt; do
    case "$opt" in
        p) case "$OPTARG" in
               low) prio=-1 ;; normal) prio=0 ;; high) prio=1 ;; urgent) prio=2 ;;
               *) echo "notify: unknown priority $OPTARG" >&2; exit 2 ;;
           esac ;;
        u) url="$OPTARG" ;;
        *) echo "usage: notify [-p low|normal|high|urgent] [-u URL] title message" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
title="${1:?usage: notify [-p priority] title message}"
message="${2:-$1}"

# shellcheck disable=SC1091
. /etc/notify.env
: "${PUSHOVER_TOKEN:?PUSHOVER_TOKEN missing from /etc/notify.env}"
: "${PUSHOVER_USER:?PUSHOVER_USER missing from /etc/notify.env}"

# Prefix with the machine name so it's clear where an alert came from
host="$(hostname -s)"
case "$title" in "$host"*) ;; *) title="$host: $title" ;; esac
# Pushover rejects anything longer than these
title="${title:0:250}"
[ ${#message} -gt 1024 ] && message="${message:0:1020}..."

args=(--form-string "token=$PUSHOVER_TOKEN" --form-string "user=$PUSHOVER_USER"
      --form-string "title=$title" --form-string "message=$message"
      --form-string "priority=$prio")
[ "$prio" = 2 ] && args+=(--form-string "retry=60" --form-string "expire=3600")
[ -n "$url" ] && args+=(--form-string "url=$url")

for _ in $(seq 1 24); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "${args[@]}" \
        https://api.pushover.net/1/messages.json)
    case "$code" in
        2*) exit 0 ;;
        4*) logger -t notify "Pushover rejected the message (HTTP $code), check /etc/notify.env: $title"
            exit 1 ;;  # bad key or message; retrying won't help
    esac
    sleep 5  # no network yet, or Pushover hiccup
done
logger -t notify "could not reach Pushover, dropped: $title: $message"
exit 1
